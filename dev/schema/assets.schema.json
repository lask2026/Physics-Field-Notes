{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "enum": [
              "concept-schematic"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string",
            "minLength": 1
          },
          "reviewNote": {
            "type": "string",
            "minLength": 1
          },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "x": {
                  "type": "number",
                  "minimum": 86,
                  "maximum": 314
                },
                "y": {
                  "type": "number",
                  "minimum": 25,
                  "maximum": 205
                }
              },
              "required": [
                "id",
                "label",
                "x",
                "y"
              ],
              "additionalProperties": false
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                }
              },
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false
            }
          },
          "visual": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "capacitor",
                  "center",
                  "charge",
                  "circuit",
                  "circulation",
                  "conductor",
                  "coulomb",
                  "decay",
                  "diffraction",
                  "distribution",
                  "electric-energy",
                  "energy",
                  "entropy",
                  "ethics",
                  "experiment",
                  "flow",
                  "fluid",
                  "forces",
                  "graph",
                  "hydrostatic",
                  "inference",
                  "kinematics",
                  "levels",
                  "logarithm",
                  "magnet",
                  "meters",
                  "motion",
                  "nucleus",
                  "optics",
                  "photoelectric",
                  "piston",
                  "polarization",
                  "potential",
                  "precision",
                  "probability",
                  "pulley",
                  "reasoning",
                  "research",
                  "resistors",
                  "sound",
                  "spectrum",
                  "spread",
                  "study",
                  "system",
                  "temperature",
                  "testing",
                  "torque",
                  "translation",
                  "triangle",
                  "units",
                  "vectors",
                  "wave",
                  "work",
                  "parallel-resistors"
                ]
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "context",
          "reviewNote",
          "nodes",
          "edges",
          "visual"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "assets"
  ],
  "additionalProperties": false
}
