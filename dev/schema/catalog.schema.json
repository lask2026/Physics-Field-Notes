{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "subject": {
      "const": "physics"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "chapters": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pilot",
              "implemented",
              "planned"
            ]
          },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "title"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "number",
          "title",
          "status",
          "sections"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "subject",
    "title",
    "chapters"
  ],
  "additionalProperties": false
}
